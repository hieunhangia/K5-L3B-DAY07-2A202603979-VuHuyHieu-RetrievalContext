# ==========================================
# Cấu hình API Keys cho Day 7 - Agentic RAG
# ==========================================

# 1. OpenAI Configuration (Chat Completion / Agent Controller)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Tùy chọn: URL tùy chỉnh nếu dùng proxy / gateway / OpenRouter (ví dụ: https://api.openai.com/v1)
OPENAI_BASE_URL=

# 2. Google Gemini Configuration (Embedding Model)
# Sử dụng một trong hai biến sau cho Gemini API:
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_EMBEDDING_MODEL=text-embedding-004
